# Copy this file to `.env` (or export these in your shell / launchd plist)
# Get these from https://developer.ebay.com/my/keys after creating an app.
# Use the "Production" Client ID / Client Secret, not sandbox, once you're
# ready to search real listings.

EBAY_CLIENT_ID=your-client-id-here
EBAY_CLIENT_SECRET=your-client-secret-here
EBAY_ENV=production
